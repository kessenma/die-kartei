# Fastfile — iOS deployment for "Die Kartei" (german-ai-flashcards)
#
# Lanes:
#   build           Local signing/archive smoke test (no upload)
#   beta            Build + upload to TestFlight (with What-to-Test changelog)
#   release         Build + upload to App Store with metadata + screenshots
#   upload_metadata Push App Store listing only (no new build)
#   bump_build      Increment build number
#   bump_version_*  Bump marketing version (patch|minor|major) + build
#   clean           Remove build artifacts
#
# Run via the logging wrapper: `python3 scripts/deploy.py [release]`
#
# Auto-versioning: `beta` and `release` now version themselves against App Store
# Connect so uploads can't collide.
#   - Marketing version is bumped until it is strictly greater than the LIVE App
#     Store version (fixes "train closed / version must be higher"). Bump size via
#     BUMP=patch|minor|major (default: minor).
#   - Build number is set to one above the highest build ASC already has for the
#     current marketing version (fixes "build must be higher").
# Toolchain guard: archiving aborts if a BETA Xcode is selected (App Store rejects
# beta-built binaries). Override the Xcode for a run with
# XCODE_PATH=/Applications/Xcode.app.

begin
  require "dotenv"
  Dotenv.load(File.join(__dir__, ".env"))
rescue LoadError
  UI.important("'dotenv' not loaded; ensure required env vars are exported.")
end

PROJECT             = "german-ai-flashcards.xcodeproj"
SCHEME              = "german-ai-flashcards"
TARGET              = "Die Kartei"
OUTPUT_NAME         = "Die Kartei.ipa"
APP_IDENTIFIER      = ENV["APP_IDENTIFIER"] || "kyle-essenmacher.german-ai-flashcards"
PROFILE_NAME        = "match AppStore #{APP_IDENTIFIER}"
EXPORT_OPTIONS_PATH = File.expand_path("../ExportOptions.plist", __dir__)
METADATA_PATH       = File.expand_path("metadata", __dir__)
SCREENSHOTS_PATH    = File.expand_path("screenshots", __dir__)
CHANGELOG_FILE      = File.expand_path("changelog.txt", __dir__) # TestFlight "What to Test"

# App Store Connect API key (account-scoped). Reused across this developer team.
def asc_api_key
  key_path = File.expand_path(
    ENV["APP_STORE_CONNECT_API_PRIVATE_KEY_PATH"] || "AuthKey_24JDJGBV9T.p8", __dir__
  )
  UI.user_error!("ASC API key not found at #{key_path} — copy the .p8 into fastlane/ and set APP_STORE_CONNECT_* in fastlane/.env") unless File.exist?(key_path)
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_filepath: key_path
  )
end

# TestFlight changelog: CHANGELOG env -> fastlane/changelog.txt -> interactive prompt (TTY).
def testflight_changelog
  return ENV["CHANGELOG"] unless ENV["CHANGELOG"].to_s.strip.empty?

  if File.exist?(CHANGELOG_FILE)
    text = File.read(CHANGELOG_FILE).strip
    return text unless text.empty?
  end

  prompt(text: "TestFlight 'What to Test' notes for this build:")
end

# --- Versioning / toolchain helpers ---------------------------------------

# Abort if the selected Xcode is a beta. App Store Connect accepts beta-built
# binaries on upload but rejects them at submission ("Unsupported SDK or Xcode
# version"). Set XCODE_PATH=/Applications/Xcode.app to pin a release toolchain
# for this run (process-scoped; no sudo, doesn't touch the system xcode-select).
def ensure_release_xcode
  xcode_select(ENV["XCODE_PATH"]) unless ENV["XCODE_PATH"].to_s.strip.empty?
  dev_dir = ENV["DEVELOPER_DIR"].to_s.strip
  dev_dir = `xcode-select -p`.strip if dev_dir.empty?
  version = `xcodebuild -version 2>/dev/null`.lines.first.to_s.strip
  UI.message("🛠  Toolchain: #{version} (#{dev_dir})")
  if dev_dir =~ /beta/i
    UI.user_error!(
      "A BETA Xcode is selected (#{dev_dir}). App Store submissions must be built with a " \
      "released Xcode. Re-run with XCODE_PATH=/Applications/Xcode.app, or switch the system " \
      "default via `sudo xcode-select -s /Applications/Xcode.app`."
    )
  end
end

# Highest build number ASC already knows about for `version` (max of TestFlight
# and App Store), so we can always upload strictly above it. Returns 0 if the
# version is new / lookups fail.
def remote_max_build(api_key, version)
  tf = (latest_testflight_build_number(api_key: api_key, version: version, initial_build_number: 0) rescue 0).to_i
  as = (app_store_build_number(api_key: api_key, version: version, initial_build_number: 0) rescue 0).to_i
  [tf, as].max
end

# Version string of the current LIVE (READY_FOR_SALE) App Store release, or nil
# if the app has never shipped / the lookup fails. Best-effort — a nil result
# just skips the version-ahead guard rather than failing the deploy.
def live_app_store_version(api_key)
  require "spaceship"
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  app&.get_live_app_store_version&.version_string
rescue => e
  UI.important("Couldn't read the live App Store version (#{e.message}); skipping version-ahead guard.")
  nil
end

default_platform(:ios)

platform :ios do
  # Sync match signing assets (read-only) and archive an app-store IPA. No upload.
  private_lane :archive_appstore do |options|
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: options[:api_key],
      readonly: true
    )
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: OUTPUT_NAME,
      clean: true,
      include_symbols: true,
      destination: "generic/platform=iOS",
      export_options: EXPORT_OPTIONS_PATH,
      xcargs: 'CODE_SIGN_STYLE=Manual ' \
              'CODE_SIGN_IDENTITY="Apple Distribution" ' \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{PROFILE_NAME}\""
    )
  end

  # Bump the marketing version until it is strictly greater than the live App
  # Store version. No-op once you're already ahead, so it's safe to run on every
  # beta/release. BUMP=patch|minor|major controls the step (default: minor).
  private_lane :ensure_version_ahead do |options|
    live = live_app_store_version(options[:api_key])
    next if live.nil?

    bump  = ENV["BUMP"] || "minor"
    local = get_version_number_from_xcodeproj(xcodeproj: PROJECT, target: TARGET)
    while Gem::Version.new(local) <= Gem::Version.new(live)
      increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: bump)
      local = get_version_number_from_xcodeproj(xcodeproj: PROJECT, target: TARGET)
      UI.message("⬆️  Marketing version -> #{local} (live App Store is #{live})")
    end
  end

  # Set CFBundleVersion to one above the highest build ASC has for the current
  # marketing version.
  private_lane :set_next_build do |options|
    version = get_version_number_from_xcodeproj(xcodeproj: PROJECT, target: TARGET)
    build   = remote_max_build(options[:api_key], version) + 1
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, build_number: build)
    UI.success("📦 Versioned as #{version} (#{build})")
  end

  desc "Local signing/archive smoke test (no upload)"
  lane :build do
    archive_appstore(api_key: asc_api_key)
  end

  desc "Build & upload to TestFlight (with What-to-Test changelog)"
  lane :beta do
    key   = asc_api_key
    notes = testflight_changelog
    ensure_release_xcode
    ensure_version_ahead(api_key: key)
    set_next_build(api_key: key)
    archive_appstore(api_key: key)
    upload_to_testflight(
      api_key: key,
      changelog: notes,
      skip_waiting_for_build_processing: ENV["SKIP_WAITING_FOR_BUILD_PROCESSING"] == "true",
      distribute_external: ENV["DISTRIBUTE_EXTERNAL"] == "true",
      notify_external_testers: ENV["NOTIFY_EXTERNAL_TESTERS"] == "true"
    )
  end

  desc "Build & upload to App Store with metadata + screenshots (manual submit)"
  lane :release do
    key = asc_api_key
    ensure_release_xcode
    ensure_version_ahead(api_key: key)
    set_next_build(api_key: key)
    archive_appstore(api_key: key) # gym stores the .ipa path for deliver
    upload_to_app_store(
      api_key: key,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true, # skip the interactive HTML preview (files are the reviewed source of truth)
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Push App Store listing (metadata + screenshots) WITHOUT a new build"
  lane :upload_metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Bump marketing version (patch) + build"
  lane :bump_version_patch do
    increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: "patch")
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Bump marketing version (minor) + build"
  lane :bump_version_minor do
    increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: "minor")
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Bump marketing version (major) + build"
  lane :bump_version_major do
    increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: "major")
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    sh("rm -rf ../build")
  end

  error do |lane, exception|
    UI.error("❌ fastlane failed in lane '#{lane}': #{exception.message}")
  end
end

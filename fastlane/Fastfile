# Fastfile — iOS deployment for "Die Kartei" (german-ai-flashcards)
#
# Lanes:
#   build           Local signing/archive smoke test (no upload)
#   beta            Build + upload to TestFlight (with What-to-Test changelog)
#   release         Build + upload to App Store with metadata + screenshots
#   upload_metadata Push App Store listing only (no new build)
#   bump_build      Increment build number
#   bump_version_*  Bump marketing version (patch|minor|major) + build
#   clean           Remove build artifacts
#
# Run via the logging wrapper: `python3 scripts/deploy.py [release]`

begin
  require "dotenv"
  Dotenv.load(File.join(__dir__, ".env"))
rescue LoadError
  UI.important("'dotenv' not loaded; ensure required env vars are exported.")
end

PROJECT             = "german-ai-flashcards.xcodeproj"
SCHEME              = "german-ai-flashcards"
TARGET              = "Die Kartei"
OUTPUT_NAME         = "Die Kartei.ipa"
APP_IDENTIFIER      = ENV["APP_IDENTIFIER"] || "kyle-essenmacher.german-ai-flashcards"
PROFILE_NAME        = "match AppStore #{APP_IDENTIFIER}"
EXPORT_OPTIONS_PATH = File.expand_path("../ExportOptions.plist", __dir__)
METADATA_PATH       = File.expand_path("metadata", __dir__)
SCREENSHOTS_PATH    = File.expand_path("screenshots", __dir__)
CHANGELOG_FILE      = File.expand_path("changelog.txt", __dir__) # TestFlight "What to Test"

# App Store Connect API key (account-scoped). Reused across this developer team.
def asc_api_key
  key_path = File.expand_path(
    ENV["APP_STORE_CONNECT_API_PRIVATE_KEY_PATH"] || "AuthKey_24JDJGBV9T.p8", __dir__
  )
  UI.user_error!("ASC API key not found at #{key_path} — copy the .p8 into fastlane/ and set APP_STORE_CONNECT_* in fastlane/.env") unless File.exist?(key_path)
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_filepath: key_path
  )
end

# TestFlight changelog: CHANGELOG env -> fastlane/changelog.txt -> interactive prompt (TTY).
def testflight_changelog
  return ENV["CHANGELOG"] unless ENV["CHANGELOG"].to_s.strip.empty?

  if File.exist?(CHANGELOG_FILE)
    text = File.read(CHANGELOG_FILE).strip
    return text unless text.empty?
  end

  prompt(text: "TestFlight 'What to Test' notes for this build:")
end

default_platform(:ios)

platform :ios do
  # Sync match signing assets (read-only) and archive an app-store IPA. No upload.
  private_lane :archive_appstore do |options|
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: options[:api_key],
      readonly: true
    )
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: OUTPUT_NAME,
      clean: true,
      include_symbols: true,
      destination: "generic/platform=iOS",
      export_options: EXPORT_OPTIONS_PATH,
      xcargs: 'CODE_SIGN_STYLE=Manual ' \
              'CODE_SIGN_IDENTITY="Apple Distribution" ' \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{PROFILE_NAME}\""
    )
  end

  desc "Local signing/archive smoke test (no upload)"
  lane :build do
    archive_appstore(api_key: asc_api_key)
  end

  desc "Build & upload to TestFlight (with What-to-Test changelog)"
  lane :beta do
    key   = asc_api_key
    notes = testflight_changelog
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
    archive_appstore(api_key: key)
    upload_to_testflight(
      api_key: key,
      changelog: notes,
      skip_waiting_for_build_processing: ENV["SKIP_WAITING_FOR_BUILD_PROCESSING"] == "true",
      distribute_external: ENV["DISTRIBUTE_EXTERNAL"] == "true",
      notify_external_testers: ENV["NOTIFY_EXTERNAL_TESTERS"] == "true"
    )
  end

  desc "Build & upload to App Store with metadata + screenshots (manual submit)"
  lane :release do
    key = asc_api_key
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
    archive_appstore(api_key: key) # gym stores the .ipa path for deliver
    upload_to_app_store(
      api_key: key,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true, # skip the interactive HTML preview (files are the reviewed source of truth)
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Push App Store listing (metadata + screenshots) WITHOUT a new build"
  lane :upload_metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Bump marketing version (patch) + build"
  lane :bump_version_patch do
    increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: "patch")
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Bump marketing version (minor) + build"
  lane :bump_version_minor do
    increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: "minor")
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Bump marketing version (major) + build"
  lane :bump_version_major do
    increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET, bump_type: "major")
    increment_build_number_in_xcodeproj(xcodeproj: PROJECT, target: TARGET)
  end

  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    sh("rm -rf ../build")
  end

  error do |lane, exception|
    UI.error("❌ fastlane failed in lane '#{lane}': #{exception.message}")
  end
end

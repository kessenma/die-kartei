<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store export options used by `scripts/deploy.py --mac`. The same
	     choices as ExportOptions.plist; the export writes a signed .pkg, which
	     deploy.py uploads with `asc builds upload --pkg`. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>RHPLRY9X9P</string>

	<!-- See ExportOptions.plist: deploy.py sets the build number itself. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>

#!/bin/bash
# Before a push: if it touches code the Android app shares, check the shared code still builds
# for Android and both apps still agree (scripts/check_android.sh). Enabled per clone with
#   git config core.hooksPath .githooks
# Skip once with SKIP_ANDROID_CHECK=1 git push (or git push --no-verify).
# Note: it checks the working tree, so uncommitted edits count too.
[ "${SKIP_ANDROID_CHECK:-0}" = "1" ] && exit 0
ROOT="$(git rev-parse --show-toplevel)"
[ -x "$ROOT/scripts/check_android.sh" ] || exit 0

ZERO=0000000000000000000000000000000000000000
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                       # deleting a branch
  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
  else
    base="$remote_sha"
  fi
  if [ -n "$base" ]; then
    changed+=$(git diff --name-only "$base" "$local_sha" 2>/dev/null)$'\n'
  else
    changed+=$(git show --name-only --format= "$local_sha")$'\n'
  fi
done

# Swift in the iOS app (core files are symlinks into it), the core and Android packages, the
# sync engine, and the script that keeps the core list.
if echo "$changed" | grep -qE '^(german-ai-flashcards/.*\.swift|DieKarteiCore/|DieKarteiAndroid/(Package\.swift|Sources/|Tests/)|KarteiSyncCore/|scripts/core_sync\.py)'; then
  full=""
  echo "$changed" | grep -qE '^DieKarteiAndroid/(Sources/KarteiStore|Tests/)' && full="--full"
  "$ROOT/scripts/check_android.sh" $full || {
    echo "pre-push: the Android check failed. Fix it, or push anyway with SKIP_ANDROID_CHECK=1."
    exit 1
  }
fi
exit 0

+def export_glb(usd_path, animated=False):
+    """[3d-android spike] GLB twin of a USD export, written next to it (.glb).
+    GLB_MODE env: SCENE (default, one merged clip per scene) or ACTIONS (one clip per action)."""
+    import os as _os
+    mode = _os.environ.get("GLB_MODE", "SCENE")
+    out = _os.path.splitext(usd_path)[0] + ("" if mode == "SCENE" else "-" + mode.lower()) + ".glb"
+    kw = dict(filepath=out, export_format="GLB", export_yup=True, export_apply=True,
+              export_cameras=False, export_lights=False, export_extras=True,
+              export_animations=animated, export_animation_mode=mode,
+              export_force_sampling=True, export_optimize_animation_size=True)
+    if mode == "SCENE":
+        kw["export_anim_scene_split_object"] = False
+    bpy.ops.export_scene.gltf(**kw)
+    print(f"GLB export {out} mode={mode}")
+
